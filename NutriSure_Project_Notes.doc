    color: #1f2937;
    margin: 30px;
  }
  h1 {
    color: #047857;
    font-size: 22pt;
    font-weight: bold;
    border-bottom: 2px solid #059669;
    padding-bottom: 8px;
    margin-top: 20pt;
    margin-bottom: 10pt;
  }
  h2 {
    color: #0f172a;
    font-size: 15pt;
